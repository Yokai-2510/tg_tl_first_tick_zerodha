# ---- SECRETS — never commit ----
config/credentials.json
config/config.json
*.pem
*.key
.env
.env.*
!.env.example
# Public backend URLs, deliberately tracked so any host builds correctly with no
# dashboard configuration. Never put a token or secret in here.
!.env.production

# ---- Runtime data ----
# Anchored with a leading slash: an unanchored "data/" also matches
# backend/data/, which silently excluded that whole package from the repo.
/data/
/logs/
*.ndjson
*.ndjson.zst
*.jsonl
access_token*
*.session

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Instrument master cache ----
*.json.gz
master.json
instruments_*.csv

# ---- Cloudflare wrangler ----
.wrangler/
.dev.vars

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
