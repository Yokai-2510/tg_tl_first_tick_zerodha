# Committed on purpose. These are NOT secrets: Vite inlines them into the bundle at
# build time, so they are readable by anyone who loads the site either way.
#
# Committing them means a fresh host deploys correctly with zero dashboard setup.
# Without this file the build falls back to http://127.0.0.1:8080 -- which, on an
# https page, points at the visitor's own machine and is blocked as mixed content.
#
# A real environment variable still wins over this file, so a host dashboard can
# override it (e.g. to point a preview build at a staging backend).
VITE_API_BASE=https://15-252-140-30.sslip.io/api/v1
VITE_WS_URL=wss://15-252-140-30.sslip.io/api/v1/ws
